# Copy to /opt/smart-learning/config/smart-learning.env on the server.
# Keep this file private on the server: chmod 600.

# Spring Boot backend
SPRING_PROFILES_ACTIVE=prod
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smart_learning_system
DB_USERNAME=smart_learning
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_ALLOW_PUBLIC_KEY_RETRIEVAL=false

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0

# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET_AT_LEAST_32_BYTES
JWT_ACCESS_EXPIRE_MS=86400000
JWT_REFRESH_EXPIRE_MS=604800000

AI_SERVICE_BASE_URL=http://127.0.0.1:8000
AI_SERVICE_CONNECT_TIMEOUT=5000
AI_SERVICE_TIMEOUT=300000
MYBATIS_LOG_IMPL=org.apache.ibatis.logging.nologging.NoLoggingImpl
KNIFE4J_ENABLE=false

# FastAPI AI service
AI_SERVICE_VERSION=2.0.0
EXTERNAL_LLM_BASE_URL=https://ws-2gca4xhi5wbpqj12.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EXTERNAL_LLM_MODEL=qwen3.7-max
EXTERNAL_LLM_API_KEY=CHANGE_ME_EXTERNAL_LLM_API_KEY

MAX_HISTORY_TURNS=10
AGENT_TEMPERATURE=0.2
AGENT_MAX_TOKENS=2000
AGENT_MAX_ITERATIONS=6
OCR_LANG=ch
OCR_USE_ANGLE_CLS=true
OCR_SHOW_LOG=false
